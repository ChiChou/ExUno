    {
      "id": "pt-ser-estar",
      "level": "A1",
      "title": "Ser e estar",
      "en": "Two ways to say be",
      "note": "Ser identifies or classifies: Sou estudante; Lisboa é uma cidade. Estar describes a current state or location: Estou cansado; O livro está na mesa. This is not simply permanent versus temporary: an event location uses ser (A festa é aqui). Ser: sou, és, é, somos, sois, são. Estar: estou, estás, está, estamos, estais, estão.",
      "verbs": {
        "rows": [
          [
            "ser-estar",
            "Ser e estar",
            "IND;PRS"
          ]
        ],
        "max": 400,
        "extra": {
          "ser": {
            "IND;PRS": "sou és é somos sois são"
          },
          "estar": {
            "IND;PRS": "estou estás está estamos estais estão"
          }
        },
