          "dividir"
        ]
      }
    },
    {
      "id": "pt-imperfeito",
      "level": "A2",
      "title": "Imperfeito",
      "en": "Past habits and background",
      "note": "Use the imperfeito for a repeated past action or background situation: Quando era criança, brincava aqui. Regular -ar verbs use -ava, -avas, -ava, -ávamos, -áveis, -avam; -er and -ir use -ia, -ias, -ia, -íamos, -íeis, -iam. Ser has era; ter has tinha; vir has vinha. Compare a scene (Chovia) with a completed event (Cheguei).",
      "verbs": {
        "rows": [
          [
            "imperfeito",
            "Imperfeito",
            "IND;PST;IPFV"
          ]
        ],
        "max": 400
