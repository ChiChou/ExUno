    {
      "id": "pt-presente",
      "level": "A1",
      "title": "Presente",
      "en": "Regular verbs in the present",
      "note": "The present describes what happens now, habits and general facts. For falar: falo, falas, fala, falamos, falais, falam. For comer: como, comes, come, comemos, comeis, comem. For partir: parto, partes, parte, partimos, partis, partem. Subject pronouns are often omitted. Tu is familiar singular; vocês takes the third-person plural. Vós is mainly regional, literary or formal.",
      "verbs": {
        "rows": [
          [
            "presente",
            "Presente",
            "IND;PRS"
          ]
        ],
        "max": 400,
        "notAlso": [
          "IND;PST;PFV"
        ]
      },
      "table": {
